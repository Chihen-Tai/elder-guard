     APKs that are handed out (security review H1). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity android:name=".debug.DebugHarnessActivity" android:exported="true" android:label="fkAd 測試台" android:launchMode="singleTop"
            android:permission="android.permission.DUMP"
            android:theme="@android:style/Theme.Material.Light"/>
    </application>
</manifest>
